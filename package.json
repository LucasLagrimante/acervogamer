{
  "name": "acervo-gamer",
  "version": "1.0.0",
  "description": "Acervo gamer pessoal — visualização da coleção de jogos",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src",
    "test:device-orientation": "node --experimental-strip-types --test tests/deviceOrientation.test.ts",
    "test": "node --experimental-strip-types --test tests/deviceOrientation.test.ts tests/collection.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "lucide-react": "^0.577.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0"
  }
